# Senhas (obrigatórias na primeira execução / reset de base)
PASS_DB=
PASS_APP=

# Auth (obrigatório — servidor não inicia sem JWT_SECRET)
# Gerar com: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRATION_HOURS=24

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=myplanner
DB_NAME=myplanner
DB_SSLMODE=disable

# Server
SERVER_PORT=9091
SERVER_HOST=0.0.0.0

# JIRA (default source)
JIRA_BASE_URL=https://totvs.atlassian.net
JIRA_AUTH_TYPE=token
JIRA_USER_EMAIL=
JIRA_API_TOKEN=

# OAuth Atlassian (opcional — sem as duas vars o botão "Conectar via Atlassian" não funciona)
# Criar app 3LO em https://developer.atlassian.com/console/myapps/
# Registrar como Callback URL exatamente: $APP_BASE_URL + /auth/atlassian/callback
ATLASSIAN_CLIENT_ID=
ATLASSIAN_CLIENT_SECRET=
APP_BASE_URL=http://localhost:9091

# Sync
SYNC_INTERVAL_MINUTES=30
SYNC_RATE_LIMIT_PER_SEC=5

# Log
LOG_LEVEL=debug
